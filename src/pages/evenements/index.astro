---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const FB_URL = "https://www.facebook.com/profile.php?id=61551881220781&locale=fr_FR";
const EMAIL = "femmesetguerrieres@gmail.com";
const PHONE = "0497/23 29 06";

const allEvents = await getCollection('events');
const now = new Date();

const upcomingEvents = allEvents
  .filter(e => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<BaseLayout
  title="Agenda"
  description="Agenda Femmes & Guerrières Liège | Groupes de parole, ateliers d'écriture et de mouvement sensoriel chaque mois. Événements bien-être et solidarité pour femmes. Rejoignez-nous !"
>
  <section class="head">
    <span class="badge">Notre agenda</span>
    <h1>Agenda</h1>
    <p class="tagline">Groupes de parole, ateliers bien-être et accompagnement — chaque mois, près de chez vous. 🩷</p>
  </section>

  {upcomingEvents.length > 0 && (
    <section class="section">
      <h2>Prochains rendez-vous</h2>
      <div class="events-grid">
        {upcomingEvents.map((event) => (
          <article class="card">
            {event.data.image && (
              <img src={event.data.image} alt={event.data.title} loading="lazy" />
            )}
            <div class="card-content">
              <h3><a href={`/evenements/${event.slug}`}>{event.data.title}</a></h3>
              <p class="date">
                📅 {event.data.date.toLocaleDateString('fr-BE', {
                  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                })}
              </p>
              <p class="location">📍 {event.data.location}</p>
              <p>{event.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Ateliers bien-être -->
  <section class="block">
    <div class="block-banner">
      <img src="/images/agenda/atelier-bien-etre.jpg" alt="Ateliers bien-être Femmes & Guerrières" loading="lazy" />
    </div>
    <div class="block-body">
      <h2>Ateliers bien-être</h2>
      <p>
        Les ateliers sont tous compris dans la <strong>cotisation membre active (40&nbsp;€/an)</strong>.
        Pour les «&nbsp;non-membres&nbsp;», ils sont au prix de <strong>10&nbsp;€/participante</strong>.
      </p>
      <p>
        Infos précises sur les heures d'atelier via <a href={FB_URL} target="_blank" rel="noopener">Facebook</a>
        ou par téléphone au <a href="tel:+32497232906">{PHONE}</a>.
      </p>
      <p>
        Confirmation obligatoire en MP ou par e-mail&nbsp;:
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a> au plus tard <strong>5 jours avant l'atelier</strong>.
      </p>
      <p class="note">
        Ces ateliers sont réalisables grâce au soutien précieux de la <strong>Fondation contre le Cancer</strong>.
      </p>
    </div>
  </section>

  <!-- Groupes de Parole -->
  <section class="block reverse">
    <div class="block-banner">
      <img src="/images/agenda/groupes-de-parole.jpg" alt="Groupes de parole Femmes & Guerrières" loading="lazy" />
    </div>
    <div class="block-body">
      <h2>Groupes de Parole</h2>
      <p>
        Rejoignez-nous pour notre <strong>groupe de parole mensuel</strong>. Nous aborderons les sujets qui
        vous touchent, en fonction de vos besoins du moment et toujours dans la bienveillance.
      </p>
      <p>
        Ces groupes sont réservés aux femmes touchées par la maladie. Habituée ou nouvelle venue, n'hésitez
        pas à passer la porte pour <strong>2h d'échanges 100% guerrière</strong>, encadrées par notre
        psychologue clinicienne.
      </p>
    </div>
  </section>

  <!-- Mais aussi ... -->
  <section class="block">
    <div class="block-banner block-banner--logo">
      <img src="/images/agenda/partenaire-fondation.png" alt="Femmes & Guerrières" loading="lazy" />
    </div>
    <div class="block-body">
      <h2>Mais aussi&nbsp;...</h2>
      <p>
        Nous proposons également de l'<strong>accompagnement personnalisé</strong>, nous participons
        régulièrement à des <strong>salons et évènements solidaires</strong>.
      </p>
      <p>N'hésitez pas à nous suivre sur Facebook et à nous contacter.</p>
      <a href={FB_URL} target="_blank" rel="noopener" class="btn-fb">📘 Nous suivre sur Facebook</a>
    </div>
  </section>

  <section class="cta">
    <h2>Une question sur nos rendez-vous&nbsp;?</h2>
    <p>Écrivez-nous, nous serons ravies de vous accueillir.</p>
    <div class="cta-btns">
      <a href={`mailto:${EMAIL}`} class="btn btn-primary">{EMAIL}</a>
      <a href="tel:+32497232906" class="btn btn-outline">☎ {PHONE}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .head { text-align: center; margin-bottom: 2.2rem; }
  .badge {
    display: inline-block; background: rgba(224,137,155,0.18);
    color: var(--color-accent-dark); font-size: 0.78rem; font-weight: 600;
    padding: 0.35rem 0.85rem; border-radius: 999px; margin-bottom: 0.8rem;
  }
  .head h1 { font-size: clamp(1.9rem, 6vw, 2.6rem); }
  .tagline { font-style: italic; color: var(--color-accent-dark); font-weight: 500; margin-top: 0.4rem; max-width: 38rem; margin-inline: auto; }

  .section { margin-bottom: 2.5rem; }
  .section h2 {
    font-size: 1.4rem; margin-bottom: 1.2rem; text-align: center;
  }
  .events-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;
  }
  .card {
    background: #fff; border-radius: 20px; overflow: hidden;
    box-shadow: var(--shadow-sm); transition: transform .15s, box-shadow .15s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .card img { width: 100%; height: 190px; object-fit: cover; background: var(--color-pink); }
  .card-content { padding: 1.3rem; }
  .card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .card .date { color: var(--color-accent-dark); font-weight: 600; margin-bottom: 0.2rem; text-transform: capitalize; }
  .card .location { color: var(--color-taupe-dark); font-size: 0.92rem; margin-bottom: 0.6rem; }

  /* Blocs informatifs (fidèles au site officiel) */
  .block {
    display: grid; grid-template-columns: 1fr 1.1fr; gap: 0;
    background: #fff; border-radius: 24px; overflow: hidden;
    box-shadow: var(--shadow-sm); margin-bottom: 1.8rem;
  }
  .block.reverse .block-banner { order: 2; }
  .block-banner { background: var(--color-pink); }
  .block-banner img { width: 100%; height: 100%; min-height: 240px; object-fit: cover; }
  .block-banner--logo { display: grid; place-items: center; padding: 2rem; }
  .block-banner--logo img { min-height: 0; max-width: 220px; height: auto; object-fit: contain; }
  .block-body { padding: 2rem; }
  .block-body h2 { font-size: 1.5rem; margin-bottom: 0.9rem; }
  .block-body p { color: var(--color-taupe-dark); margin-bottom: 0.8rem; }
  .block-body a { color: var(--color-accent-dark); font-weight: 600; text-decoration: underline; }
  .block-body .note {
    font-size: 0.92rem; font-style: italic; background: var(--color-cream);
    border-left: 3px solid var(--color-accent); padding: 0.7rem 0.9rem; border-radius: 8px; margin-top: 1rem;
  }
  .btn-fb {
    display: inline-block; margin-top: 0.6rem; padding: 0.7rem 1.3rem; border-radius: 999px;
    background: var(--color-accent-dark); color: #fff !important; font-weight: 600;
    text-decoration: none !important; box-shadow: 0 8px 20px rgba(199,106,128,0.32); transition: transform .15s;
  }
  .btn-fb:hover { transform: translateY(-2px); }

  .cta {
    text-align: center; background: linear-gradient(160deg, var(--color-accent), var(--color-accent-dark));
    color: #fff; border-radius: 26px; padding: 2.5rem 1.5rem; box-shadow: var(--shadow); margin-top: 2.5rem;
  }
  .cta h2 { font-size: 1.5rem; margin-bottom: 0.4rem; }
  .cta p { opacity: 0.92; margin-bottom: 1.4rem; }
  .cta-btns { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 0.8rem 1.5rem; border-radius: 999px; font-weight: 600; transition: transform .15s; }
  .btn-primary { background: #fff; color: var(--color-accent-dark); }
  .btn-primary:hover { transform: translateY(-2px); color: var(--color-accent-dark); }
  .btn-outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.75); }
  .btn-outline:hover { background: #fff; color: var(--color-accent-dark); }

  @media (max-width: 720px) {
    .block, .block.reverse { grid-template-columns: 1fr; }
    .block.reverse .block-banner { order: 0; }
    .block-banner img { min-height: 200px; }
  }
</style>
