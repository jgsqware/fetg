---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await event.render();
---

<BaseLayout title={event.data.title} description={event.data.description}>
  <article class="event">
    <header>
      <h1>{event.data.title}</h1>
      <div class="meta">
        <p class="date">
          📅 {event.data.date.toLocaleDateString('fr-BE', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
          {event.data.endDate && (
            <span> - {event.data.endDate.toLocaleDateString('fr-BE', {
              weekday: 'long',
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}</span>
          )}
        </p>
        <p class="location">📍 {event.data.location}</p>
      </div>
    </header>

    {event.data.image && (
      <img src={event.data.image} alt={event.data.title} class="featured-image" />
    )}

    <div class="content">
      <Content />
    </div>

    {event.data.photos && event.data.photos.length > 0 && (
      <section class="photos">
        <h2>Photos de l'événement</h2>
        <div class="photos-grid">
          {event.data.photos.map((photo, index) => (
            <a href={photo} class="photo-item" target="_blank">
              <img src={photo} alt={`Photo ${index + 1} - ${event.data.title}`} />
            </a>
          ))}
        </div>
      </section>
    )}

    <footer>
      <a href="/evenements">&larr; Retour aux événements</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .event {
    max-width: 900px;
    margin: 0 auto;
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .meta {
    background: var(--color-white);
    padding: 1rem 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .date {
    color: var(--color-secondary);
    font-weight: 500;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .location {
    color: #666;
  }

  .featured-image {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .content {
    background: var(--color-white);
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-bottom: 2rem;
  }

  .content :global(h2) {
    color: var(--color-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
  }

  .content :global(ul), .content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .photos {
    margin-bottom: 2rem;
  }

  .photos h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .photo-item {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .photo-item:hover img {
    transform: scale(1.05);
  }

  footer {
    padding-top: 1rem;
    border-top: 1px solid #eee;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 1.75rem;
    }

    .content {
      padding: 1rem;
    }

    .photos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
