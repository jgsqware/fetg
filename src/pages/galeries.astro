---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const FB_PHOTOS_URL = "https://www.facebook.com/profile.php?id=61551881220781&sk=photos";

// Albums construits à partir des événements passés qui ont des photos.
const events = await getCollection('events');
const albums = events
  .filter((e) => e.data.photos && e.data.photos.length > 0)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Galeries">
  <section class="head">
    <span class="badge">En images</span>
    <h1>Galeries</h1>
    <p>Quelques souvenirs de nos rencontres, ateliers et moments de partage.</p>
  </section>

  {albums.length > 0 ? (
    <div class="albums">
      {albums.map((event) => (
        <article class="album">
          <div class="album-cover">
            <img src={event.data.photos[0]} alt={event.data.title} loading="lazy" />
            <span class="album-count">📷 {event.data.photos.length}</span>
          </div>
          <div class="album-body">
            <h3>{event.data.title}</h3>
            <p>{event.data.date.toLocaleDateString('fr-BE', { month: 'long', year: 'numeric' })}</p>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <section class="empty-card">
      <div class="empty-emoji">🌸</div>
      <h2>Bientôt en ligne</h2>
      <p>Nos albums photos arrivent prochainement ici. En attendant, retrouvez toutes nos photos sur notre page Facebook.</p>
      <a href={FB_PHOTOS_URL} target="_blank" rel="noopener" class="btn-fb">📘 Voir les photos sur Facebook</a>
    </section>
  )}

  <section class="follow">
    <p>Suivez-nous pour ne rien manquer&nbsp;:</p>
    <a href={FB_PHOTOS_URL} target="_blank" rel="noopener" class="btn-fb-ghost">📘 Notre page Facebook</a>
  </section>
</BaseLayout>

<style>
  .head { text-align: center; margin-bottom: 2rem; }
  .badge {
    display: inline-block; background: rgba(224,137,155,0.18);
    color: var(--color-accent-dark); font-size: 0.78rem; font-weight: 600;
    padding: 0.35rem 0.85rem; border-radius: 999px; margin-bottom: 0.8rem;
  }
  .head h1 { font-size: clamp(1.9rem, 6vw, 2.6rem); margin-bottom: 0.4rem; }
  .head p { color: var(--color-taupe-dark); }

  .albums {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.2rem;
  }
  .album {
    background: #fff; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-sm);
    transition: transform .15s, box-shadow .15s;
  }
  .album:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .album-cover { position: relative; aspect-ratio: 4 / 3; background: var(--color-pink); }
  .album-cover img { width: 100%; height: 100%; object-fit: cover; }
  .album-count {
    position: absolute; bottom: 8px; right: 8px;
    background: rgba(33,27,25,0.7); color: #fff; font-size: 0.78rem;
    padding: 0.2rem 0.55rem; border-radius: 999px;
  }
  .album-body { padding: 1rem; }
  .album-body h3 { font-size: 1.05rem; }
  .album-body p { font-size: 0.85rem; color: var(--color-taupe); text-transform: capitalize; }

  .empty-card {
    text-align: center; background: #fff; border-radius: 26px;
    padding: 3rem 1.5rem; box-shadow: var(--shadow-sm); max-width: 40rem; margin: 0 auto;
  }
  .empty-emoji {
    width: 70px; height: 70px; margin: 0 auto 1rem; display: grid; place-items: center;
    font-size: 2rem; background: var(--color-pink); border-radius: 20px;
  }
  .empty-card h2 { font-size: 1.4rem; margin-bottom: 0.5rem; }
  .empty-card p { color: var(--color-taupe-dark); max-width: 28rem; margin: 0 auto 1.5rem; }

  .btn-fb, .btn-fb-ghost {
    display: inline-block; padding: 0.8rem 1.5rem; border-radius: 999px; font-weight: 600;
    transition: transform .15s;
  }
  .btn-fb { background: var(--color-accent-dark); color: #fff; box-shadow: 0 8px 20px rgba(199,106,128,0.32); }
  .btn-fb:hover { transform: translateY(-2px); color: #fff; }

  .follow { text-align: center; margin-top: 2.5rem; }
  .follow p { color: var(--color-taupe-dark); margin-bottom: 0.8rem; }
  .btn-fb-ghost { background: var(--color-cream); color: var(--color-accent-dark); border: 2px solid var(--color-accent); }
  .btn-fb-ghost:hover { background: var(--color-accent-dark); color: #fff; }
</style>
