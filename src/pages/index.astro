---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();
const upcomingEvents = allEvents
  .filter(e => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('fr-BE', { weekday: 'short', day: 'numeric', month: 'long' });
---

<BaseLayout title="Accueil">
  <section class="hero">
    <span class="badge">ASBL · Tinlot, Belgique</span>
    <h1>Femmes <span>&amp;</span> Guerrières</h1>
    <p>Un espace d'entraide, d'écoute et d'empowerment féminin. Ensemble, on se relève plus fortes.</p>
    <div class="hero-cta">
      <a href="/soutenir" class="btn btn-primary">Soutenir l'association</a>
      <a href="/evenements" class="btn btn-ghost">Voir l'agenda</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Prochains événements</h2>
      <a href="/evenements" class="see-all">Tout voir →</a>
    </div>

    {upcomingEvents.length > 0 ? (
      <div class="ev-list">
        {upcomingEvents.map((event) => (
          <a href={`/evenements/${event.slug}`} class="ev-card">
            <div class="ev-date">
              <span class="ev-day">{event.data.date.getDate()}</span>
              <span class="ev-month">{event.data.date.toLocaleDateString('fr-BE', { month: 'short' })}</span>
            </div>
            <div class="ev-body">
              <h3>{event.data.title}</h3>
              <p class="ev-meta">🕑 {fmtDate(event.data.date)} · 📍 {event.data.location}</p>
              <p class="ev-desc">{event.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">Aucun événement à venir pour le moment.</p>
    )}
  </section>

  <section class="section">
    <div class="join-card">
      <h2>Rejoignez le mouvement</h2>
      <p>Devenez membre pour accéder à tous nos ateliers et groupes de parole, ou soutenez l'asbl par une simple participation libre.</p>
      <div class="join-cta">
        <a href="/soutenir" class="btn btn-primary">Participation libre</a>
        <a href="/soutenir" class="btn btn-outline">Devenir membre</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3.5rem 1.25rem;
    background: linear-gradient(160deg, #ffffff 0%, var(--color-pink) 100%);
    border-radius: 26px;
    box-shadow: var(--shadow);
    margin-bottom: 2.5rem;
  }
  .badge {
    display: inline-block;
    background: rgba(224, 137, 155, 0.18);
    color: var(--color-accent-dark);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.1rem;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 7vw, 3.4rem);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .hero h1 span { color: var(--color-accent-dark); }
  .hero > p {
    max-width: 30rem;
    margin: 0 auto 1.6rem;
    color: var(--color-taupe-dark);
    font-size: 1.05rem;
  }
  .hero-cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    transition: transform .15s, box-shadow .15s, background .15s;
  }
  .btn-primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 8px 20px rgba(33, 27, 25, 0.22);
  }
  .btn-primary:hover { transform: translateY(-2px); color: #fff; }
  .btn-ghost {
    background: rgba(255,255,255,0.7);
    color: var(--color-text);
  }
  .btn-ghost:hover { transform: translateY(-2px); }
  .btn-outline {
    background: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }
  .btn-outline:hover { background: var(--color-primary); color: #fff; }

  .section { margin-bottom: 2.5rem; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .section-head h2 { font-size: 1.5rem; }
  .see-all { font-weight: 600; font-size: 0.9rem; }

  .ev-list { display: flex; flex-direction: column; gap: 0.9rem; }
  .ev-card {
    display: flex;
    gap: 1rem;
    background: #fff;
    border-radius: var(--radius);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
    color: inherit;
    transition: transform .15s, box-shadow .15s;
  }
  .ev-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .ev-date {
    flex: 0 0 64px;
    height: 64px;
    border-radius: 14px;
    background: var(--color-pink);
    color: var(--color-taupe-dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .ev-day { font-size: 1.5rem; font-weight: 700; color: var(--color-text); }
  .ev-month { font-size: 0.72rem; text-transform: uppercase; font-weight: 600; }
  .ev-body h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .ev-meta { font-size: 0.82rem; color: var(--color-taupe); margin-bottom: 0.35rem; }
  .ev-desc {
    font-size: 0.92rem;
    color: var(--color-taupe-dark);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .join-card {
    text-align: center;
    background: linear-gradient(160deg, var(--color-accent), var(--color-accent-dark));
    color: #fff;
    border-radius: 26px;
    padding: 3rem 1.5rem;
    box-shadow: var(--shadow);
  }
  .join-card h2 { font-size: 1.6rem; margin-bottom: 0.6rem; }
  .join-card p { max-width: 32rem; margin: 0 auto 1.5rem; opacity: 0.92; }
  .join-cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .join-card .btn-primary { background: #fff; color: var(--color-accent-dark); box-shadow: none; }
  .join-card .btn-outline { color: #fff; border-color: rgba(255,255,255,0.7); }
  .join-card .btn-outline:hover { background: #fff; color: var(--color-primary); }

  .empty { color: var(--color-taupe); font-style: italic; }
</style>
