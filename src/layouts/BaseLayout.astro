---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Femmes & Guerrières - Soutien et entraide pour les femmes confrontées à la maladie. Groupes de parole, bien-être et accompagnement en Belgique." } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// Barre du bas (mobile) — 4 entrées max
const nav = [
  { href: "/", label: "Accueil", icon: "🏠" },
  { href: "/evenements", label: "Agenda", icon: "📅" },
  { href: "/soutenir", label: "Soutenir", icon: "💛" },
  { href: "/contact", label: "Contact", icon: "✉️" },
];

// Navigation complète (desktop)
const topLinks = [
  { href: "/", label: "Accueil" },
  { href: "/a-propos", label: "Qui sommes-nous" },
  { href: "/evenements", label: "Agenda" },
  { href: "/galeries", label: "Galeries" },
  { href: "/articles", label: "News" },
  { href: "/contact", label: "Contact" },
];
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FDF6F4" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Femmes et Guerrières</title>
  </head>
  <body>
    <header class="topbar">
      <nav class="topnav">
        <a href="/" class="logo">
          <img src="/logo.jpeg" alt="Femmes & Guerrières" class="logo-img" />
          <span>Femmes&nbsp;&amp;&nbsp;Guerrières</span>
        </a>
        <ul class="topnav-links">
          {topLinks.map((item) => (
            <li>
              <a href={item.href} class={isActive(item.href) ? "active" : ""}>{item.label}</a>
            </li>
          ))}
        </ul>
        <a href="/soutenir" class="topnav-cta">Devenir membre</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p class="footer-title">Femmes &amp; Guerrières</p>
      <p>Association sans but lucratif — Région de Liège, Belgique</p>
      <p class="footer-small">&copy; {new Date().getFullYear()} — Tous droits réservés</p>
    </footer>

    <nav class="bottomnav">
      {nav.map((item) => (
        <a href={item.href} class={isActive(item.href) ? "active" : ""}>
          <span class="bn-icon">{item.icon}</span>
          <span class="bn-label">{item.label}</span>
        </a>
      ))}
    </nav>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --color-primary: #211B19;        /* encre noire du logo */
    --color-primary-dark: #000000;
    --color-accent: #E0899B;         /* rose mauve aquarelle */
    --color-accent-dark: #C76A80;
    --color-cream: #FDF4F2;
    --color-pink: #F8DAD4;
    --color-pink-deep: #F2C3BC;
    --color-taupe: #9A8A86;
    --color-taupe-dark: #6E5F5B;
    --color-text: #211B19;
    --color-white: #ffffff;
    --radius: 18px;
    --shadow: 0 8px 30px rgba(100, 88, 83, 0.12);
    --shadow-sm: 0 2px 12px rgba(100, 88, 83, 0.10);
    --bottomnav-h: 64px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
    color: var(--color-text);
    background:
      radial-gradient(1200px 600px at 100% -10%, var(--color-pink) 0%, transparent 55%),
      var(--color-cream);
    background-attachment: fixed;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem calc(2rem + var(--bottomnav-h));
  }

  a { color: var(--color-primary); text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }
  h1, h2, h3 { line-height: 1.25; letter-spacing: -0.02em; }

  /* ---------- Top bar (desktop) ---------- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(253, 246, 244, 0.85);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid rgba(136, 119, 118, 0.14);
  }
  .topnav {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    white-space: nowrap;
  }
  .logo-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }
  .topnav-links {
    list-style: none;
    display: flex;
    gap: 1.4rem;
    margin-left: auto;
  }
  .topnav-links a {
    font-weight: 500;
    color: var(--color-taupe-dark);
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: color .15s, border-color .15s;
  }
  .topnav-links a:hover { color: var(--color-accent-dark); }
  .topnav-links a.active {
    color: var(--color-accent-dark);
    border-bottom-color: var(--color-accent-dark);
  }
  .topnav-cta {
    background: var(--color-primary);
    color: #fff;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    box-shadow: 0 6px 16px rgba(33, 27, 25, 0.22);
    transition: transform .15s, box-shadow .15s;
  }
  .topnav-cta:hover { transform: translateY(-1px); color:#fff; }

  /* ---------- Footer ---------- */
  footer {
    text-align: center;
    padding: 2.5rem 1rem calc(2.5rem + var(--bottomnav-h));
    color: var(--color-taupe-dark);
    border-top: 1px solid rgba(136, 119, 118, 0.14);
  }
  .footer-title { font-weight: 700; color: var(--color-text); }
  .footer-small { font-size: .8rem; opacity: .7; margin-top: .5rem; }

  /* ---------- Bottom nav (mobile webapp feel) ---------- */
  .bottomnav {
    display: none;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 200;
    height: calc(var(--bottomnav-h) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(160%) blur(14px);
    border-top: 1px solid rgba(136, 119, 118, 0.16);
    grid-template-columns: repeat(4, 1fr);
  }
  .bottomnav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--color-taupe);
    font-size: 0.7rem;
    font-weight: 500;
    transition: color .15s;
  }
  .bottomnav a .bn-icon {
    font-size: 1.2rem;
    line-height: 1;
    filter: grayscale(40%);
    transition: transform .15s, filter .15s;
  }
  .bottomnav a.active { color: var(--color-accent-dark); }
  .bottomnav a.active .bn-icon { filter: none; transform: translateY(-1px) scale(1.08); }

  @media (max-width: 760px) {
    .topnav-links, .topnav-cta { display: none; }
    .topnav { justify-content: center; }
    .bottomnav { display: grid; }
  }
</style>
