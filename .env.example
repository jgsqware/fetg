# Synchronisation automatique des événements depuis Facebook (optionnel)
# À définir dans Vercel > Project > Settings > Environment Variables.
# Sans ces valeurs, le site conserve simplement les événements présents dans le repo.

# Identifiant numérique de la PAGE Facebook (pas un profil)
FB_PAGE_ID=

# Token d'accès Page avec la permission pages_read_engagement
FB_ACCESS_TOKEN=
